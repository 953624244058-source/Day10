
#include <stdio.h>

int main() {
    int limit, n, temp, digit;
    int sum, count, i, j, power;

    printf("Enter limit: ");
    scanf("%d", &limit);

    for (i = 1; i <= limit; i++) {
        n = i;
        temp = n;
        count = 0;
        sum = 0;

        while (temp > 0) {
            count++;
            temp = temp / 10;
        }

        temp = n;

        while (temp > 0) {
            digit = temp % 10;
            power = 1;

            for (j = 1; j <= count; j++) {
                power = power * digit;
            }

            sum = sum + power;
            temp = temp / 10;
        }

        if (sum == n) {
            printf("%d ", n);
        }
    }

    return 0;
}
